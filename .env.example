# Free Groq key: https://console.groq.com/keys  (no credit card)
# Leave empty to run with a built-in mock model (handy for local UI work).
LLM_API_KEY=

# Any OpenAI-compatible endpoint works. Defaults shown.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# CHAT_MODEL=openai/gpt-oss-120b
# MEMORY_MODEL=openai/gpt-oss-20b

# Postgres (Neon free tier via Vercel). Leave empty locally to use an embedded
# PGlite database stored in ./.data
DATABASE_URL=
